<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Employee</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Edit Employee</h1>
    <form action="/update/<%= employee.id %>" method="POST">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" value="<%= employee.name %>" required><br><br>

        <label for="department">Department:</label>
        <input type="text" id="department" name="department" value="<%= employee.department %>" required><br><br>

        <label for="salary">Basic Salary:</label>
        <input type="number" id="salary" name="salary" value="<%= employee.salary %>" min="0" step="0.01"
            required><br><br>

        <button type="submit">Update Employee</button>
    </form>
    <a href="/">Back to Dashboard</a>
</body>

</html>